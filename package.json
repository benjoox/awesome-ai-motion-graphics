{
  "name": "awesome-ai-motion-graphics",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "markdownlint-cli2",
    "typecheck": "tsc --noEmit",
